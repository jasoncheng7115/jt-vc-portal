# configure-realm.sh 參數。複製為 realm.env（chmod 600）。不要放進版控。
REALM=jtvc
# jt-vc-portal 對外網址（redirect URI 會是 <PORTAL_URL>/sso-callback）
PORTAL_URL=https://vc.example.com
CLIENT_ID=jt-vc-portal
# Keycloak 對外網址（只用於輸出提示）
KC_ISSUER_BASE=https://sso.example.com

# AD（LDAPS）
LDAP_URL=ldaps://dc1.example.com:636
LDAP_BASE_DN=DC=example,DC=com
LDAP_BIND_DN=CN=svc-keycloak,CN=Users,DC=example,DC=com
# 可留空，之後在管理介面填（User federation → ad → Bind credentials）
LDAP_BIND_CREDENTIAL=
LDAP_GROUPS_DN=CN=Groups,DC=example,DC=com
ADMIN_GROUP=VC-Admins
HOST_GROUP=VC-Hosts

# Keycloak 暴力破解偵測：連續失敗 N 次即暫時鎖定（務必小於 AD 的帳號鎖定門檻）
LOCKOUT_FAILURES=5

# 管理介面網址（與 .env 的 KC_ADMIN_URL 相同）；設定後 master realm 登入頁一律走此內網網址
KC_ADMIN_URL=https://10.0.0.20:8443

# master realm 管理員（執行本腳本用）
KC_ADMIN_USER=
KC_ADMIN_PASSWORD=
