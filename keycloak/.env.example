# 複製為 .env（chmod 600），填入實際值。不要把 .env 放進版控。
KC_VERSION=26.4
# 使用者瀏覽器看到的 Keycloak 網址（反向代理終結 TLS）
KC_PUBLIC_URL=https://sso.example.com
# 管理介面網址（只在內網使用；反向代理不可轉送 /admin）
KC_ADMIN_URL=http://10.0.0.20:8080
KC_BIND_ADDR=0.0.0.0
# 以 openssl rand -base64 32 產生
KC_DB_PASSWORD=CHANGE_ME
# 首次啟動用的暫時管理員（只給 docker-compose.bootstrap.yml 用）；建好正式管理員後把這兩行刪掉（見 SOP）
KC_BOOTSTRAP_ADMIN_USERNAME=temp-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
