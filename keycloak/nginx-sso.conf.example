# 反向代理（nginx）設定範例：對外只開放登入 / OIDC 必要路徑，管理介面一律不轉送。
# 假設 TLS 憑證已由既有流程（例如 certbot）處理；Keycloak 主機為 10.0.0.20:8080。
server {
    listen 443 ssl http2;
    server_name sso.example.com;

    ssl_certificate     /etc/letsencrypt/live/sso.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sso.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    # master realm（Keycloak 管理員登入）只走內網管理網址，對外一律拒絕（必須放在其他 /realms 規則之前）
    location ~ ^/realms/master(/|$) { return 404; }

    # 登入請求限速（防暴力破解的第一道：每 IP 每分鐘 20 次登入 POST）
    # 需在 http {} 內宣告：limit_req_zone $binary_remote_addr zone=kc_login:10m rate=20r/m;
    location ~ ^/realms/[^/]+/login-actions/authenticate {
        limit_req zone=kc_login burst=10 nodelay;
        proxy_pass http://10.0.0.20:8080;
        include /etc/nginx/snippets/kc-proxy.conf;
    }

    # 只轉送 realm 登入 / OIDC / 靜態資源
    location ~ ^/(realms|resources)/ {
        proxy_pass http://10.0.0.20:8080;
        include /etc/nginx/snippets/kc-proxy.conf;
    }

    # 其餘（含 /admin、/metrics、/health、根目錄、/realms/master）一律拒絕
    location / { return 404; }
}

# /etc/nginx/snippets/kc-proxy.conf
#   proxy_set_header Host              $host;
#   proxy_set_header X-Forwarded-Host  $host;
#   proxy_set_header X-Forwarded-Proto https;
#   proxy_set_header X-Forwarded-Port  443;
#   proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#   proxy_buffer_size 128k;
#   proxy_buffers 4 256k;
#   proxy_busy_buffers_size 256k;
